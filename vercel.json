{
  "builds": [
    { "src": "api/*.php", "use": "vercel-php" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "style.css", "use": "@vercel/static" },
    { "src": "script.js", "use": "@vercel/static" },
    { "src": "69ccb-597.txt", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/admin.php", "dest": "/api/admin.php" },
    { "src": "/process_payment.php", "dest": "/api/process_payment.php" },
    { "src": "/success.php", "dest": "/api/success.php" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
