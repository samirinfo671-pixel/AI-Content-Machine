{
  "framework": null,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    { "source": "/admin.php", "destination": "/api/admin.php" },
    { "source": "/process_payment.php", "destination": "/api/process_payment.php" },
    { "source": "/success.php", "destination": "/api/success.php" }
  ]
}
